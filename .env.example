# Copiá este archivo a ".env" (sin el ".example") y completá tus valores.
# El archivo ".env" NO se versiona (está en .gitignore): los secretos quedan
# solo en tu máquina. Lo que ya exista en el entorno pisa a lo de este archivo.
#
#   cp .env.example .env   y después editá .env

# ---------------------------------------------------------------------------
# Asistente de escritura con IA (opcional)
# ---------------------------------------------------------------------------
# Proveedor: openai | groq | openrouter | anthropic | gemini | ollama
MHSR_AI_PROVIDER=openai

# Tu API key del proveedor. Para "ollama" (local) puede quedar vacía.
MHSR_AI_KEY=

# Modelo a usar (si se omite, se elige un default por proveedor).
# MHSR_AI_MODEL=gpt-4o-mini

# URL base alternativa (por ejemplo, un endpoint OpenAI-compatible propio).
# MHSR_AI_URL=

# Segundos de espera por respuesta (default: 40).
# MHSR_AI_TIMEOUT=40
